{
  "$schema": "https://opencode.ai/config.json",

  // Default model
  "model": "openai/gpt-5.6-sol",

  // Default primary agent
  "default_agent": "build",

  "mcp": {
    "servers": {
      // Up-to-date programming documentation
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
    },
  },

  //Safety and permissions:
  "permissions": [
    //can add more here if needed
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow",
    },
  ],
  // Disable session sharing
  "share": "disabled",

  // Automatically update OpenCode
  "update": "auto",

  // Context compaction
  "compaction": {
    "auto": true,
  },
}
