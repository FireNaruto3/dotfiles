{   
    "reload-style-on-change": true,

    "layer": "bottom",
    "position": "top",

    "margin-top": 0,
    "margin-bottom": 0,
    "margin-right": 0,
    "margin-left": 0,

    "modules-left": ["custom/applauncher","niri/workspaces","sway/workspaces", "sway/mode", "sway/window","mpris"],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "tray",
        "cpu",
        "temperature",
        "memory",
        "pulseaudio",
        "battery",
        "custom/power"
        
    ],

    "niri/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false,
        "on-click": "activate",
        "format": "{index}",
        "active-only": false,
        "exclude-empty-workspaces": true
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "tooltip": false
    },
    "custom/applauncher": {
        "format": "〇",
        "on-click": "pgrep -x wofi >/dev/null && pkill -x wofi || wofi --show drun --location=top --yoffset=15",
        "tooltip": false
    },
    "sway/window": {
        "max-length": 20
    },
    "mpris": {
        "format": "DEFAULT: {player_icon} {dynamic}",
        "format-paused": "DEFAULT: {status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
	    },
        "max-length": 30
    },


    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5
    },
    "tray": {
        "spacing": 10,
        "tooltip": false
    },
    "memory": {
        "interval": 30,
        "format": "{used:0.1f}G/{total:0.1f}G "
    },
    "battery": {
        "states": {
        "warning": 30,
        "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-alt": "{icon}{time}",
        "format-full": "󱈑 {capacity}%",
        "format-icons": [
        "󱊡",
        "󱊢",
        "󱊣"
        ],
        "tooltip": true,
        "tooltip-format": "{timeTo} — {power:.1f}W"
    },
    "clock": {
        "format": "󰅐  {:%I:%M %p}",
        "tooltip": false
    },
    "network": {
        "format-wifi": " {bandwidthDownBits}",
        "format-ethernet": " {bandwidthDownBits}",
        "format-disconnected": "󰤮 No Network",
        "interval": 5,
        "tooltip": false
    },
    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-icons": [
        "",
        "",
        " "
        ],
        "nospacing": 1,
        "format-muted": " ",
        "on-click": "pavucontrol",
        "tooltip": false
    },
    "custom/power": {
        "on-click": "wlogout",
        "format": "",
        "tooltip": false
    },
    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip": false
    }
}