#!/bin/sh

tag=quickshell-secure-suspend

report_failure() {
    message=$1
    logger -p authpriv.err -t "$tag" -- "$message"

    if [ -n "${user:-}" ] && [ -n "${uid:-}" ]; then
        runuser -u "$user" -- env \
            XDG_RUNTIME_DIR="/run/user/$uid" \
            DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            notify-send -u critical "Suspend blocked" "$message" >/dev/null 2>&1 || :
    fi

    printf '%s: %s\n' "$tag" "$message" >&2
}

session_info=$(
    loginctl list-sessions --no-legend 2>/dev/null |
    (
        fallback_count=0
        while read -r session uid user rest; do
            properties=$(loginctl show-session "$session" \
                -p Active -p Remote -p Type 2>/dev/null) || continue
            active=
            remote=
            type=

            while IFS='=' read -r property value; do
                case $property in
                    Active) active=$value ;;
                    Remote) remote=$value ;;
                    Type) type=$value ;;
                esac
            done <<EOF
$properties
EOF

            [ "$remote" = "no" ] || continue
            [ "$type" = "wayland" ] || continue

            if [ "$active" = "yes" ]; then
                printf '%s %s %s\n' "$session" "$uid" "$user"
                exit 0
            fi

            fallback_count=$((fallback_count + 1))
            fallback_info="$session $uid $user"
        done

        # logind may briefly clear Active while preparing a lid-close suspend.
        [ "$fallback_count" -eq 1 ] && printf '%s\n' "$fallback_info"
    )
)

if [ -z "$session_info" ]; then
    report_failure "No active local Wayland session is available to secure before suspend."
    exit 1
fi

set -- $session_info
session=$1
uid=$2
user=$3

if timeout --foreground --signal=TERM --kill-after=1s 14s \
    runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        systemctl --user start quickshell-secure-lock.service; then
    exit 0
fi

report_failure "Session $session did not acquire a secure Wayland lock within the timeout; suspend was aborted."
exit 1
