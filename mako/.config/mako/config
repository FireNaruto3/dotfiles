background-color=#303446
text-color=#9fef00
border-color=#9fef00
border-size=2
border-radius=10
padding=12
margin=10

font=JetBrains Mono Nerd Font 11
default-timeout=6000
ignore-timeout=false

width=350
height=120
anchor=top-right
# outer-margin=0,0,50,0
sort=-time
layer=overlay

icons=true
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark

progress-color=over #8caaee

[urgency=low]
border-color=#EBEB26
default-timeout=4000

[urgency=normal]
border-color=#26EB39
default-timeout=6000

[urgency=critical]
border-color=#EB2628
text-color=#EB2628
default-timeout=0

[mode=do-not-disturb]
invisible=1